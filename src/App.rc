// wxWidgets' standard resources, including the manifest for common controls v6 and per-monitor DPI awareness.
#include "wx/msw/wx.rc"

#include "Version.h"

// Shown in Explorer's Properties > Details.
1 VERSIONINFO
FILEVERSION     NBTAA_VERSION_MAJOR, NBTAA_VERSION_MINOR, NBTAA_VERSION_PATCH, 0
PRODUCTVERSION  NBTAA_VERSION_MAJOR, NBTAA_VERSION_MINOR, NBTAA_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "supermegamau"
            VALUE "FileDescription", "NBT-AA-Installer: installs NBT-AAD on an NBT Evo head unit over SSH"
            VALUE "FileVersion", NBTAA_VERSION_TEXT
            VALUE "InternalName", "NBT-AA-Installer"
            VALUE "LegalCopyright", "Copyright (c) 2026 supermegamau. PolyForm Noncommercial 1.0.0"
            VALUE "OriginalFilename", "NBT-AA-Installer.exe"
            VALUE "ProductName", "NBT-AA-Installer"
            VALUE "ProductVersion", NBTAA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
